"}]," = ",["$","span",null,{"className":"math-cases","children":[["$","span",null,{"children":[["$","span",null,{"className":"math-word","children":"insert"}],["$","sub",null,{"children":"next"}],"(",["$","$Lf",null,{"term":"Q"}],", ",["$","$Lf",null,{"term":"rho"}],") ",["$","small",null,{"children":["if ",["$","$Lf",null,{"term":"repairEntities"}]," ∩ ",["$","$Lf",null,{"term":"activeEntities"}]," ≠ ∅"]}]]}],["$","span",null,{"children":[["$","span",null,{"className":"math-word","children":"append"}],"(",["$","$Lf",null,{"term":"Q"}],", ",["$","$Lf",null,{"term":"rho"}],") ",["$","small",null,{"children":"otherwise"}]]}]]}]]}]}],["$","p",null,{"className":"equation-example","children":["Shared entities put repair immediately after the active skill. Otherwise it follows remaining work. Equivalent repairs are deduplicated; ",["$","strong",null,{"children":"the current instruction is not interrupted."}]]}]]}],["$","aside",null,{"className":"method-equation","children":[["$","h3",null,{"children":"Memory selects an instruction; the frozen policy acts"}],["$","div",null,{"className":"equation-lines","children":[["$","div",null,{"children":[["$","$Lf",null,{"term":"c"}]," = ",["$","span",null,{"className":"math-word","children":"active"}],"(",["$","$Lf",null,{"term":"Q"}],")"]}],["$","div",null,{"children":["(",["$","i",null,{"children":"y"}],["$","sub",null,{"children":"τ"}],", Â",["$","sub",null,{"children":"τ"}],["$","sup",null,{"children":"1:J"}],") = π",["$","sub",null,{"children":"G0.5"}],"(",["$","$Lf",null,{"term":"observations"}],", ",["$","$Lf",null,{"term":"c"}],", ",["$","i",null,{"children":"e"}],["$","sub",null,{"children":"R1"}],"; ",["$","$Lf",null,{"term":"weights"}],")"]}],["$","small",null,{"className":"math-key","children":[["$","span",null,{"children":[["$","i",null,{"children":"y"}],["$","sub",null,{"children":"τ"}],": optional reasoning tokens"]}],["$","span",null,{"children":[["$","span",null,{"className":"math-vector","children":"Â"}],["$","sub"