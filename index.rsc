4}],["$","$L1e","3",{"children":4}],["$","$L1e","4",{"children":0}],["$","$L1e","5",{"children":0}]]}]]}]]}]}],["$","div",null,{"className":"prose","children":[["$","h3",null,{"children":"Progress is different from full success"}],["$","p",null,{"children":"Checkpoint progress is the fraction of evaluator-defined checkpoints satisfied; full success requires all checkpoints. Relative to the strongest baseline in each family, REMM increases mean progress from 57% to 91% for T1 and from 43% to 70% for T2. REMM completes all four physical T3 trials."}]]}],["$","div",null,{"className":"research-table-wrap","role":"region","aria-label":"Mean checkpoint progress · T1 pools T1a and T1b","tabIndex":0,"children":["$","$L19",null,{"className":"research-table","children":[["$","caption",null,{"children":"Mean checkpoint progress · T1 pools T1a and T1b"}],["$","$L1a",null,{"children":["$","$L1b",null,{"children":[["$","$L1c","System",{"scope":"col","children":"System"}],["$","$L1c","T1",{"scope":"col","children":"T1"}],["$","$L1c","T2",{"scope":"col","children":"T2"}],["$","$L1c","T3",{"scope":"col","children":"T3"}]]}]}],["$","$L1d",null,{"children":[["$","$L1b","0",{"className":"","children":[["$","$L1c","0",{"scope":"row","children":"Vanilla G0.5"}],["$","$L1e","1",{"children":"39.0%"}],["$","$L1e","2",{"children":"13.3%"}],["$","$L1e","3",{"children":"33.3%"}]]}],["$","$L1b","1",{"className":"","children":[["$","$L1c","0",{"scope":"row","children":"HiMe"}],["$","$L1e","1",{"children":"57.1%"}],["$","$L1e","2",{"children":"43.3%"}],["$","$L1e","3",{"children":"0.0%"}]]}],["$","$L1b","2",{"className":"ours-row","children":[["$","$L1c","0",{"scope":"row","children":"REMM"}],["$","$L1e","1",{"children":"91.1%"}],["$","$L1e","2",{"children":"70.0%"}],["$","$L1e","3",{"children":"100.0%"}]]}]]}]]}]}],["$","div",null,{"className":"research-table-wrap","role":"region","aria-label":"Decision accuracy / non-failure completion · eligible labeled trials","tabIndex":0,"children":"$L1f"}]