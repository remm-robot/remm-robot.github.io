1:[["$","a",null,{"className":"skip","href":"#video","children":"Skip to content"}],["$","header",null,{"className":"site-header","children":[["$","a",null,{"href":"#overview","className":"site-name","children":"REMM"}],["$","nav",null,{"aria-label":"Page sections","children":[["$","a",null,{"href":"#results","children":"Results"}],["$","a",null,{"href":"/appendix/","children":"Appendix"}]]}],["$","$Ld",null,{}]]}],["$","main",null,{"children":[["$","section",null,{"className":"paper-header","id":"overview","children":[["$","h1",null,{"children":[["$","span",null,{"children":"REMM:"}],["$","br",null,{}],["$","span",null,{"className":"paper-subtitle","children":["Revisable Embodied Memory",["$","br",null,{"className":"title-break"}]," for Manipulation"]}]]}],["$","p",null,{"className":"project-note","children":"Anonymous authors • Under review"}],["$","p",null,{"className":"tldr","children":[["$","strong",null,{"children":"TL;DR"}]," REMM links visual evidence to revisable task state, allowing a robot to update its memory and schedule recovery around a frozen manipulation policy."]}]]}],["$","section",null,{"className":"paper-section prose","id":"video","children":[["$","h2",null,{"children":"Video overview"}],["$","video",null,{"className":"overview-video","controls":true,"playsInline":true,"preload":"metadata","poster":"/videos/remm-overview-poster.jpg","aria-label":"REMM project overview and experiments","children":[["$","source",null,{"src":"/videos/remm-overview.mp4","type":"video/mp4"}],"Your browser does not support embedded video."]}],["$","p",null,{"className":"section-caption","children":"A three-minute overview of REMM, physical task demonstrations, and evaluation. Subtitles are included in the video."}]]}],["$","section",null,{"className":"paper-section prose","id":"abstract","children":[["$","h2",null,{"children":"Abstract"}],["$","p",null,{"children":"History-dependent manipulation requires a robot to distinguish what happened earlier, what remains true, and what still needs to be done. A previously verified placement can become invalid after an object moves, while the event itself remains part of the task’s history. Retaining observations alone does not resolve these changes."}],["$","p",null,{"children":"REMM is an external, evidence-linked memory and supervisory-control layer for a frozen manipulation policy. It separates historical events from revisable current assertions, propagates loss of support through explicit dependencies, and inserts targeted recovery skills into a task queue. The executor receives one bounded instruction at a time. Across 51 physical trials, REMM improves mean checkpoint progress over the strongest baseline from 57% to 91% on intervention recovery and from 43% to 70% on sequence recall. Matched generated-video diagnostics further separate remembering history from grounding it into an executable instruction."}]]}],["$","section",null,{"className":"paper-section","id":"method","children":[["$","h2",null,{"children":"Method overview"}],["$","figure",null,{"className":"paper-figure architecture-figure","children":[["$","a",null,{"href":"/figures/architecture.png","target":"_blank","rel":"noopener noreferrer","aria-label":"Open architecture figure at full resolution","children":["$","img",null,{"src":"/figures/architecture.png","width":"1480","height":"475","alt":"Paper architecture figure: observations, REMM, frozen G0.5 and the robot execution loop on the left; REMM task, evidence, and memory revision components on the right."}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"REMM architecture."}]," The execution loop is shown on the left, with REMM’s task, evidence, and memory-revision components on the right. Select the figure to view it at full resolution."]}]]}],["$","p",null,{"className":"prose intro","children":"REMM maintains task state outside the policy. Visual evidence updates memory; the supervisor selects the next nominal or recovery skill, and G0.5 executes the selected instruction with its native sensory inputs."}],"$Le"]}],"$Lf","$L10","$L11","$L12"]}],"$L13"]
:HL["/figures/teaser.png","image"]
e:["$","div",null,{"className":"prose method-text","children":[["$","h3",null,{"children":"Evidence-linked state revision"}],["$","p",null,{"children":"Accepted evidence updates current object relations while preserving the underlying event history. When a supporting fact becomes inactive, conclusions that depend on it are invalidated. For example, an object’s location inferred from containment loses support when that containment relation no longer holds."}],["$","h3",null,{"children":"Recovery and verification"}],["$","p",null,{"children":"A relevant disturbance schedules repair after the active skill; unrelated recovery can be deferred until the nominal queue is complete. A pending repair may change destination as new evidence arrives. Visual outcome checks determine whether the supervisor advances, retries, or pauses for review."}]]}]
f:["$","figure",null,{"className":"teaser paper-figure","children":[["$","img",null,{"src":"/figures/teaser.png","width":"1190","height":"600","alt":"Illustrative comparison: a disturbed completed condition remains stale without revision, while REMM schedules a repair."}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Revising a completed condition."}]," The paper’s teaser illustrates how a disturbance can invalidate earlier task progress and lead to a targeted repair. This is a qualitative example, not an aggregate result."]}]]}]
10:[["$","section",null,{"className":"paper-section","id":"tasks","children":[["$","h2",null,{"children":"Physical experiments"}],["$","div",null,{"className":"prose","children":[["$","p",null,{"children":["We evaluate REMM in ",["$","strong",null,{"children":"51 physical trials"}]," on Galaxea R1 Lite. All three systems use the frozen G0.5 executor: Vanilla G0.5 without external memory, a strong memory-enabled baseline (HiMe), and REMM. The comparison measures the complete deployed systems; the memory baseline is a controlled adaptation, not an official reproduction."]}],["$","p",null,{"children":"The tasks separate three questions: can a controller revise a previously satisfied condition, retain information that is no longer visible, and turn that information into the correct next instruction?"}]]}],["$","figure",null,{"className":"paper-figure task-figure","children":[["$","img",null,{"src":"/figures/setup.png","width":"970","height":"855","loading":"lazy","alt":"Physical task sequences for T1a, T1b, T2, and T3. Orange borders identify robot execution and blue borders identify human motion."}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Physical evaluation setups."}]," T1a tests recovery with queued work; T1b tests a changed recovery destination. T2 tests order memory and disturbed execution; T3 tests hidden-object identity."]}]]}],["$","div",null,{"className":"prose task-list","children":[["$","article",null,{"children":[["$","h3",null,{"children":"T1a · Recovery with queued work"}],["$","p",null,{"children":"After a relevant placement and full arm retraction, a human moves the designated object out of its container while unrelated work remains queued. The controller must revise the affected completed condition and schedule a bounded repair without interrupting the active skill."}]]}],["$","article",null,{"children":[["$","h3",null,{"children":"T1b · Destination changes after pouring"}],["$","p",null,{"children":"Exactly one designated residual object remains in the bowl after pouring and retraction. Its required final destination is the green tray. Later accepted evidence must revise stale completion and resolve the pending recovery against the current destination."}]]}],["$","article",null,{"children":[["$","h3",null,{"children":"T2 · Ordered recall and disturbed repeats"}],["$","p",null,{"children":"Three colored cues are introduced sequentially and then covered. The robot must match their remembered order to current objects and execute the placements in sequence. Predeclared disturbed repeats relocate a pending or already placed target, testing repair without losing the remaining order. A delayed-recall variant inserts two unrelated placements before ordered retrieval."}]]}],["$","article",null,{"children":[["$","h3",null,{"children":"T3 · Hidden-object rearrangement"}],["$","p",null,{"children":"The robot observes an object–cup binding and must retain the cover’s identity through a shuffle before selecting the cup to lift. The controlled physical protocol moves one cup at a time with pauses; faster or fully overlapping shuffles are a different observability condition."}]]}]]}],["$","p",null,{"className":"prose section-caption","children":"The overview video above includes physical demonstrations. Full trial-video release remains in preparation."}]]}],["$","section",null,{"className":"paper-section","id":"results","children":[["$","h2",null,{"children":"Physical results"}],["$","div",null,{"className":"prose","children":["$","p",null,{"children":["REMM completes ",["$","strong",null,{"children":"10 of 17 trials"}],", compared with 2 of 16 for HiMe and 0 of 18 for Vanilla G0.5. Seven REMM trials remain partial; none is labeled a complete failure. These pooled counts are descriptive because the task mix and sample sizes differ."]}]}],"$L14","$L15","$L16","$L17"]}],"$L18"]
11:["$","section",null,{"className":"paper-section prose","id":"appendix","children":[["$","h2",null,{"children":"Technical appendix"}],["$","p",null,{"children":"Inspect JSON records, step through memory revision, and follow the references from visual evidence to a recovery instruction."}],["$","p",null,{"className":"appendix-link","children":["$","a",null,{"href":"/appendix/","children":"Read the technical appendix →"}]}]]}]
12:["$","section",null,{"className":"paper-section prose status","id":"limitations","children":[["$","h2",null,{"children":"Scope and limitations"}],["$","p",null,{"children":"REMM uses compiler-supplied dependencies, conservative 2D perception, and boundary-only repair. The physical study uses one robot and controlled tabletop interventions. The generated clips isolate memory readout and grounding, not physical task completion. Broader testing is needed for unconstrained occlusion, appearance shift, new task semantics, and other robots."}]]}]
