15:["$","figure",null,{"className":"paper-figure result-figure profile-figure","children":[["$","a",null,{"href":"/figures/system-profile.png","target":"_blank","rel":"noopener noreferrer","children":["$","img",null,{"src":"/figures/system-profile.png","loading":"lazy","alt":"Paper system profiles comparing Vanilla G0.5, the memory baseline (HiMe), and REMM across task progress, decisions, non-failure completion, time and query efficiency."}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Progress and cost, together."}]," REMM improves checkpoint progress while adding perception and verification overhead. Higher values indicate better performance or efficiency; full success remains separate from partial completion."]}]]}]
