e:["$","figcaption",null,{"children":[["$","strong",null,{"children":"The execution loop."}]," REMM selects the atomic instruction ",["$","$L1a",null,{"term":"c"}],"; the frozen ",["$","a",null,{"className":"reference-link","href":"https://opengalaxea.github.io/G05/","target":"_blank","rel":"noopener noreferrer","children":"G0.5"}]," policy executes it with native visual and robot-state inputs."]}]
f:["$","p",null,{"className":"prose intro","children":["REMM maintains ",["$","strong",null,{"children":"task state outside the policy"}],". Visual evidence updates memory; the supervisor selects the next nominal or recovery skill. The active instruction ",["$","$L1a",null,{"term":"c"}]," stays fixed until a ",["$","strong",null,{"children":"verified skill boundary"}],"."]}]
10:["$","figure",null,{"className":"paper-figure architecture-detail","children":[["$","a",null,{"href":"/figures/architecture-memory-transparent-v3.png","target":"_blank","rel":"noopener noreferrer","aria-label":"Enlarge REMM internal architecture","children":["$","img",null,{"src":"/figures/architecture-memory-transparent-v3.png","width":"1898","height":"1334","loading":"lazy","alt":"REMM internals: task decomposition and skill contracts, source-specific evidence gates, event ledger, assertion records, support graph, dependency invalidation, and recovery scheduling."}]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Inside REMM."}]," Task, evidence, and memory revision connect accepted observations to a revised skill queue. Select either diagram to enlarge it."]}]]}]
